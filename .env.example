# EchoLock — environment variable template
# Copy this file to .env and fill in values locally.
# NEVER commit .env or any real credentials to the repository.

# Optional external AI provider (not required for MVP or any tests)
# ECHOLOCK_AI_PROVIDER=     # e.g. "watsonx" — leave unset for offline deterministic mode
# ECHOLOCK_AI_API_KEY=      # provider API key — leave unset for offline mode
# ECHOLOCK_AI_MODEL=        # e.g. "ibm/granite-13b-instruct-v2"
# ECHOLOCK_AI_ENDPOINT=     # provider endpoint URL
