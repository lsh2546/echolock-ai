# ============================================================
# EchoLock — .gitignore
# ============================================================

# --- Python bytecode and caches ---
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.env/

# --- Credentials and secrets (NEVER commit) ---
.env
*.env
.envrc
secrets.toml
credentials.json
*.key
*.pem
*.p12
*.pfx

# --- Coverage and test artifacts ---
.coverage
.coverage.*
htmlcov/
coverage.xml
*.lcov
.pytest_cache/
.hypothesis/

# --- Build and distribution artifacts ---
dist/
build/
*.egg-info/
*.egg
MANIFEST
*.whl

# --- IDEs and editors ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Jupyter notebooks ---
.ipynb_checkpoints/
*.ipynb

# --- Mypy / type-checking caches ---
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# --- Audit log artifacts (local only) ---
audit_log*.json
audit_log*.jsonl
local_audit/

# --- Temporary and scratch files ---
*.tmp
*.bak
tmp/
scratch/

# --- GitHub Actions local runner artifacts ---
act/
